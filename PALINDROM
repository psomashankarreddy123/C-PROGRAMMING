#include<stdio.h>
int main()
{
    int num,originalnum,reversednum=0,remainder;
    printf("Enter the number : ");
    scanf("%d",&num);
    
    originalnum = num;
    while(num !=0)
    {
      remainder = num%10;
      reversednum = reversednum *10 + remainder;
      num /=10;
    }
    if(originalnum ==reversednum)
    {
        printf("The number is a palindrom %d\n");
    }else{
        printf("The number is not a palindrom %d\n");
    }
    return 0;
}


