Anagram
#include<stdio.h>
#include <string.h>
int main()
{
 char str1[100]="car";
 char str2[100]="arc";
 char ch,temp;
 int i,j, len1,len2;
 len1 = strlen(str1);
 len2 = strlen(str2);
 if(len1 != len2)
 {
 printf("given strings are not anagram");
 return 0;
 }
 for (i = 0; i < len1-1; i++)
 {
 for (j = i+1; j < len1; j++)
 {
 if (str1[i] > str1[j])
 {
 temp = str1[i];
 str1[i] = str1[j];
 str1[j] = temp;
 }
 if (str2[i] > str2[j])
 {
