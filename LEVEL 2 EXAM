THE UNION OF TWO ARRAY'S :-

#include <stdio.h>
int main() 
{
    int A[10]={12,56,78,94,16,96,54,32,52,81},B[10]={21,66,44,89,11,46,39,23,41,75},C[20],i,j;
    for(i=0;i<10;i++)
    {
        C[i]=A[i];
    }
    for(j=0;j<10;j++)
    {
        C[i+j]=B[j];
    }
    for(i=0;i<20;i++)
    {
        printf("%d\t",C[i]);
    }
    return 0;
}

