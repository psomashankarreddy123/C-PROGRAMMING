#include <stdio.h>
void swapx(int x, int y) 
{
    int t;
    t = x;
    x = y;
    y = t;

    printf("Inside swap: x = %d y = %d\n", x, y);
}
int main() 
{
    int a = 10, b = 20;
    swapx(a, b);
    printf("Inside main: a = %d b = %d", a, b);
    return 0;
}

Inside swap: x = 20 y = 10
Inside main: a = 10 b = 20

=== Code Execution Successful ===
